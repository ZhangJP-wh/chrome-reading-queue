{
  "manifest_version": 3,
  "name": "阅读队列 Reading Queue",
  "version": "2.1.3",
  "description": "右键把链接或当前页加入阅读队列；未读 / 星标 / 历史三页签；可标为已读或未读；当前页在未读时图标显示绿勾；关闭后按顺序打开下一个。",
  "permissions": [
    "contextMenus",
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "阅读队列",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
